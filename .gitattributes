# ==============================================================================
# PROJECT REVOLUTION — GIT LFS CONFIGURATION (.gitattributes)
# ==============================================================================

# Treat text files normally with LF / CRLF handling
*.c text
*.cpp text
*.h text
*.hpp text
*.cs text
*.ini text
*.json text
*.xml text
*.md text
*.txt text
*.csv text
*.ps1 text
*.cmd text
*.bat text
*.sh text

# --- Unreal Engine Binary Assets (LFS Tracking) ---
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

# --- 3D DCC Models & Scene Files ---
*.blend filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.usd filter=lfs diff=lfs merge=lfs -text
*.usda filter=lfs diff=lfs merge=lfs -text
*.usdc filter=lfs diff=lfs merge=lfs -text
*.abc filter=lfs diff=lfs merge=lfs -text

